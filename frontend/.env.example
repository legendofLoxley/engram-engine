# Supabase project credentials (from Supabase dashboard → Settings → API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API base URL — leave empty when using Vite's dev proxy (same-origin in prod via Ktor)
# Set to https://your-backend.ondigitalocean.app for separate-origin deployments
VITE_API_URL=
