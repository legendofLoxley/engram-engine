+// engram-engine dev-bridge addition: the running-executions panel's own Cancel button. A single
+// delegated listener (not one per rendered button) survives _renderActivityItems' own full
+// innerHTML rebuild on every poll, so it never needs re-attaching.
+document.addEventListener('click', function(e){
+  const btn = e.target && e.target.closest && e.target.closest('.activity-cancel-btn');
+  if(!btn) return;
+  _cancelHermesActivity(btn.dataset.assignmentId, btn);
+});
+
+async function _cancelHermesActivity(assignmentId, btn){
+  if(!assignmentId) return;
+  if(btn){ btn.disabled = true; btn.textContent = 'Cancelling…'; }
+  try{
+    await api('/api/hermes-activity/cancel?assignmentId='+encodeURIComponent(assignmentId), {timeoutToast:false, retries:0});
+    // Whatever the outcome (requested or not-active), re-poll immediately rather than waiting up
+    // to 15s for the next tick — no optimistic removal before that confirms it, since a request
+    // is never a guarantee (same framing as every other cancellation path in this bridge).
+    _loadWorkspacePanelActivity();
+  }catch(e){
+    if(btn){ btn.disabled = false; btn.textContent = 'Cancel'; }
+  }
+}
