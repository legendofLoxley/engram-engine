+def _persist_runner_done_session(payload) -> None:
+    """engram-engine dev-bridge patch: a runner-local "done" event's
+    session.messages is otherwise only ever applied to the browser's
+    in-memory S.session (static/messages.js _finishDone) — nothing writes it
+    to WebUI's own on-disk Session store, so a page reload (which re-fetches
+    the session from disk via get_session()) loses the whole runner-backed
+    conversation. This mirrors what the legacy (non-runner) chat path already
+    does for every turn: load the session, set its messages, save it. See
+    engram-engine's webui-bridge/vendor-patches/ for the full patch context.
+    """
+    if not isinstance(payload, dict):
+        return
+    session_data = payload.get("session")
+    if not isinstance(session_data, dict):
+        return
+    session_id = session_data.get("session_id")
+    messages = session_data.get("messages")
+    if not session_id or not isinstance(messages, list):
+        return
+    try:
+        from api.models import get_session
+
+        s = get_session(session_id, metadata_only=False)
+        if s is None:
+            return
+        s.messages = list(messages)
+        s.save()
+    except Exception:
+        logger.debug("failed to persist runner-local session messages for %s", session_id, exc_info=True)
+
