        "type": "array",
        "items": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Stable external id (the Notion page id). The same id again is the same document."
                },
                "title": {
                    "type": "string",
                    "description": "The document's title."
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "notion_page"
                    ]
                },
                "url": {
                    "type": "string",
                    "description": "Where the document lives."
                },
                "text": {
                    "type": "string",
                    "description": "The full text. Send this or `chunks`, not both."
                },
                "chunks": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "text": {
                                "type": "string",
                                "description": "The chunk's text."
                            },
                            "location": {
                                "type": "string",
                                "description": "Where it sits, e.g. \"section: Budget\"."
                            }
                        },
                        "required": [
                            "text"
                        ],
                        "additionalProperties": false
                    },
                    "description": "The text already cut into chunks. Send this or `text`, not both."
                },
                "last_edited": {
                    "type": "string",
                    "description": "When the document was last edited, if known (ISO date or time). It sets the evidence date of items filed from this source: an item reads as fresh as the page says (never later than now), so a task from a page untouched for two months is asked about (\"still live?\") instead of raised as overdue. Send the page again with a later last_edited to refresh its items; send it again with an earlier one to correct items imported earlier that no one has touched since (an item the owner confirmed or changed is never lowered). Without it, items start fresh as of the import."
                }
            },
            "required": [
                "id",
                "title",
                "kind"
            ],
            "additionalProperties": false
        },
        "maxItems": 5
